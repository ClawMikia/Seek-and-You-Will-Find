<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BibleVerse" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="android:statusBarColor">@color/burgundy_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/parchment_dark</item>
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.BibleVerse.BottomSheet</item>
        <item name="materialButtonStyle">@style/Widget.BibleVerse.Button</item>
    </style>

    <style name="Theme.BibleVerse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/burgundy_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cross</item>
        <item name="postSplashScreenTheme">@style/Theme.BibleVerse</item>
    </style>

    <style name="ThemeOverlay.BibleVerse.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BibleVerse.BottomSheet</item>
    </style>

    <style name="Widget.BibleVerse.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

    <style name="Widget.BibleVerse.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="backgroundTint">@color/burgundy</item>
        <item name="android:textColor">@color/parchment_light</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.BibleVerse.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="strokeColor">@color/gold_dark</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/burgundy</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="TextAppearance.BibleVerse.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/ink_brown</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <style name="TextAppearance.BibleVerse.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/burgundy</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.BibleVerse.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/gold_dark</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="TextAppearance.BibleVerse.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink_brown_secondary</item>
    </style>

</resources>
