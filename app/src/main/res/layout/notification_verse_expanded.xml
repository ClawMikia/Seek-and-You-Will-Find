<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notification"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_cross"
            android:contentDescription="@string/cd_cross_icon" />

        <TextView
            android:id="@+id/tvNotifReference"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="@color/burgundy"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNotifVerseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:textColor="@color/ink_brown"
        android:textSize="14sp"
        android:maxLines="5"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvNotifTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:textColor="@color/gold_dark"
        android:textSize="11sp"
        android:letterSpacing="0.08" />

</LinearLayout>
