<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/spacing_s"
    android:paddingBottom="@dimen/spacing_s">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_alarm"
        android:alpha="0.7"
        android:contentDescription="@string/cd_alarm" />

    <TextView
        android:id="@+id/tvReminderTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_s"
        android:textAppearance="@style/TextAppearance.BibleVerse.Body"
        android:textColor="@color/burgundy"
        android:textStyle="bold"
        android:textSize="@dimen/text_title" />

    <ImageButton
        android:id="@+id/btnRemoveReminder"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_close"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_remove_reminder" />

</LinearLayout>
